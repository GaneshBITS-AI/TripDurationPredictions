# Streamlit UI. A thin HTTP client over the API service - no model,
# sklearn, xgboost, or mlflow in this image at all.
FROM python:3.13-slim

WORKDIR /app

COPY docker/requirements/streamlit.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY streamlit_app.py .

EXPOSE 8501
ENTRYPOINT ["streamlit", "run", "streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
